# Copy to .dev.vars for Wrangler local preview (`npm run preview`).
# Do not commit real keys.
OPENROUTER_API_KEY=

# Optional. OpenRouter model for the Ask page (/chat). Must support tool calling.
# Empty = anthropic/claude-haiku-5.5.
CHAT_MODEL=

# Optional. Empty = unlocked. Production: npx wrangler secret put SITE_PASSWORD
SITE_PASSWORD=

# Optional Cloudflare Access assertion validation. Set both together.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Slack archive. Empty = events route returns not configured. See README.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# Signs MCP OAuth tokens. At least 32 characters. Empty disables /mcp (503).
MCP_SIGNING_KEY=
