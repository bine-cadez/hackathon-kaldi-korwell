# Copy to .dev.vars for Wrangler local preview (`npm run preview`).
# Do not commit real keys.
OPENROUTER_API_KEY=

# Optional. Empty = unlocked. Production: npx wrangler secret put SITE_PASSWORD
SITE_PASSWORD=

# Optional Cloudflare Access assertion validation. Set both together.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Signs MCP OAuth tokens. At least 32 characters. Empty disables /mcp (503).
MCP_SIGNING_KEY=
