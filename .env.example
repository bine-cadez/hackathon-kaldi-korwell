# Copy to .env for `npm run dev`.
# Copy the same line to .dev.vars for `wrangler dev` / `npm run preview`.
# Do not commit real keys.
OPENROUTER_API_KEY=

# Optional shared password. Empty = unlocked (local/dev).
# When set, pages and data APIs require it. GET /api/health stays public.
# Production: npx wrangler secret put SITE_PASSWORD
SITE_PASSWORD=

# Optional Cloudflare Access assertion validation. Set both together.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Slack archive. Leave unset and the events route answers "not configured"
# instead of crashing. Production: npx wrangler secret put <NAME>
# SLACK_CHANNEL_IDS is a comma-separated list of channel ids (C… / G…).
# An empty list archives nothing.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# Signs MCP OAuth tokens. At least 32 characters. Empty disables /mcp (503).
# Production: npx wrangler secret put MCP_SIGNING_KEY
# Generate: openssl rand -base64 32
MCP_SIGNING_KEY=

# Load the Workers AI binding in `npm run dev` so PDF, Word, and Excel uploads
# convert locally. Requires `npx wrangler login` first. Without it, dev works
# but only text and markdown uploads succeed.
AI_REMOTE=
