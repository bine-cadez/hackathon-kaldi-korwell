{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doc-library",
  // workers.dev Version URLs, including PR aliases from `wrangler versions upload --preview-alias`.
  // `versions upload` does not change this setting; the next `wrangler deploy` does.
  // https://developers.cloudflare.com/workers/versions-and-deployments/version-urls/
  "preview_urls": true,
  // Optional gate: `npx wrangler secret put SITE_PASSWORD` (unset = unlocked).
  // Do not put the password in this file. Cloudflare Access can replace the
  // in-app gate later. Wrangler has no portable Access block (it needs your
  // Zero Trust account). After deploy, open Workers & Pages → doc-library →
  // Access, protect this Worker, and choose all traffic.
  // Slack cannot send an Access JWT. Add one Access Bypass policy for
  // POST /api/slack/events only. The route checks X-Slack-Signature.
  // Do not bypass /api/slack/search or /api/slack/backfill.
  // Secrets (not vars): SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, SLACK_CHANNEL_IDS.
  // MCP OAuth: `npx wrangler secret put MCP_SIGNING_KEY` (at least 32 characters).
  // Do not put it in this file either. /mcp, /token, /register, and
  // /.well-known/oauth-* must be Access Bypass paths. /authorize must stay
  // behind Access. See the README.
  // https://developers.cloudflare.com/workers/configuration/cloudflare-access/
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doc-library",
      "database_id": "3f6350fe-7ed5-4b5c-baaf-fad9e47e1571",
      "migrations_dir": "migrations",
    },
  ],
  // The Workers AI binding (AI) is in nuxt.config.ts (nitro.cloudflare.wrangler),
  // not here, so `npm run dev` does not need `wrangler login`.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "doc-chunks",
    },
  ],
}
